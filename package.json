{
  "name": "weave",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "bun src/server/main.ts",
    "dev": "vite",
    "dev:mock": "bun scripts/dev-mock.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "effect-tsgo tsc --noEmit",
    "lint": "effect-tsgo oxlint --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun run --bun vitest run --passWithNoTests",
    "test:watch": "bun run --bun vitest",
    "verify": "bun .agents/skills/verify-weave/harness/verify.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "@effect/atom-react": "4.1.2",
    "@effect/platform-bun": "4.1.2",
    "@opencode/client": "2.3.0",
    "effect": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "scheduler": "0.28.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.4",
    "@effect/vitest": "4.1.2",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "effect": "4.1.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
